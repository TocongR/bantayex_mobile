<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Was: whatever Material3/Compose theme the default "Empty Activity" template
        generated (parent Theme.Material3...NoActionBar or similar). Every screen in
        this app uses AppCompatActivity plus Material Components widgets (TextInputLayout,
        MaterialButton, MaterialCardView), which require a Theme.MaterialComponents
        (or Theme.AppCompat) ancestor — using the Compose template's theme as-is causes
        a runtime crash the moment the first Activity inflates
        ("You need to use a Theme.AppCompat theme (or descendant) with this activity").
    -->
    <style name="Theme.Bantayex" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>
</resources>