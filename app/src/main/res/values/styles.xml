<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ Existing input styles (kept as-is) ============ -->

    <style name="LoginInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">0.5dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxStrokeColor">@color/input_border</item>
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxBackgroundColor">@color/surface_secondary</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="CodeBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/code_box_default</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="SectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="MinimalInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>
        <item name="boxStrokeColor">@color/divider</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- ============ NEW: shared button styles ============ -->
    <!-- Added because activity_login.xml (and every screen after it) was repeating
         these attributes inline instead of referencing a style. From here on,
         every primary/outlined button in the app uses one of these two. -->

    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="strokeColor">@color/input_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Small variant for inline actions like "+ New Exam" — inherits color/elevation/
         stateListAnimator from Primary and only overrides size, instead of the old
         approach of copy-pasting all 6 attributes again for a smaller button. -->
    <style name="Widget.App.Button.Primary.Small" parent="Widget.App.Button.Primary">
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Two more small outlined variants, same reasoning as Primary.Small above:
         inherit color/stroke/elevation from Outlined, override only size. -->
    <style name="Widget.App.Button.Outlined.Small" parent="Widget.App.Button.Outlined">
        <item name="android:layout_height">48dp</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <style name="Widget.App.Button.Outlined.Compact" parent="Widget.App.Button.Outlined">
        <item name="android:layout_height">36dp</item>
        <item name="android:textSize">12sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Distinct on purpose: a small floating pill button over exam content, not a
         full-width primary CTA, so it doesn't share Primary's color/shape. Formalized
         as a style anyway (instead of leaving it inline) so it's documented in one
         place like every other button in the app. -->
    <style name="Widget.App.Button.Pill" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">44dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">#171B26</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">22dp</item>
    </style>
</resources>