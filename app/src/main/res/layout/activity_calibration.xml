<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Solid white backdrop shown only once calibration actually starts -->
    <View
        android:id="@+id/whiteBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone"/>

    <com.example.bantayex.monitoring.FaceMeshOverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Pre-calibration guide: shown before the user taps Start -->
    <ScrollView
        android:id="@+id/preCalibrationContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:id="@+id/imgCalibrationGuide"
                android:layout_width="wrap_content"
                android:layout_height="170dp"
                android:layout_gravity="center_horizontal"
                android:adjustViewBounds="true"
                android:src="@drawable/calibration_guide"
                android:contentDescription="Phone screen showing the nine calibration dots, with the center dot marked first"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Keep your face centered in the frame.\n• Look straight at the center dot first to set your starting position.\n• When the next dot appears, follow it with your eyes and hold your gaze on it until it moves.\n• Keep your head and phone still for the whole calibration — only your eyes should move."
                android:textColor="@color/white"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvPositionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Position your head in the center of the frame"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnStartCalibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Calibration"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvCalibrationFailed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calibration failed. Make sure your face is visible and well-lit."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Retry calibration"
            android:visibility="gone"/>

    </LinearLayout>

</FrameLayout>