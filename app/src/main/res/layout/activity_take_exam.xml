<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Top bar ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvExamTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvViolationCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#E53935"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/timer_background"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"/>

        <!-- ── Gaze status banner -->
        <TextView
            android:id="@+id/tvGazeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone"/>

        <!-- ── Loading indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="48dp"
            android:visibility="visible"/>

        <!-- ── Main exam content ── everything below this is fixed-height,
             it deliberately does NOT stretch to fill the screen -->
        <FrameLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Row holding submit button (start) and camera preview
                     (end) — same vertical position, mirrored sides. This is
                     the row Step 5b left a 72dp gap for. -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="12dp">

                    <!-- Was: 9 inline attributes. Now: style reference only
                         (same fix as Step 5b). -->
                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="16dp"
                        android:text="Submit"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        style="@style/Widget.App.Button.Pill"/>

                    <!-- Camera preview — small, top-right corner -->
                    <FrameLayout
                        android:id="@+id/cameraPreviewContainer"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginEnd="16dp"
                        android:layout_gravity="end"
                        android:background="@drawable/camera_preview_border"
                        android:visibility="gone">

                        <androidx.camera.view.PreviewView
                            android:id="@+id/previewViewExam"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>

                    </FrameLayout>

                </FrameLayout>

                <!-- Question counter -->
                <TextView
                    android:id="@+id/tvQuestionCounter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Question 1 of 10"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.08"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp"/>

                <!-- Swipeable question card — FIXED height, stops well above
                     the bottom of the screen on purpose. Content inside scrolls
                     if it overflows (handled in item_question_page.xml). -->
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:layout_marginBottom="8dp"/>

                <!-- Explicit arrows for students who don't swipe; kept compact
                     and outlined so they stay visually behind the question card. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <Button
                        android:id="@+id/btnPrevQuestion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="← Previous"
                        style="@style/Widget.App.Button.Outlined.Compact" />

                    <Button
                        android:id="@+id/btnNextQuestion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Next →"
                        style="@style/Widget.App.Button.Outlined.Compact" />

                </LinearLayout>

                <!-- Dead space — intentionally empty, users shouldn't need to
                     look down here. Takes up all remaining room below the card. -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Full-screen border overlay -->
    <View
        android:id="@+id/screenBorderOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"/>

    <!-- Center "look here" indicator during gaze warnings/violations -->
    <com.example.bantayex.monitoring.GazeIndicatorOverlayView
        android:id="@+id/gazeIndicatorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"/>

</FrameLayout>